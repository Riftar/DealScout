# Copy to .env and fill in. .env is ignored by git.

# Any OpenAI-compatible endpoint.
LLM_BASE_URL=
LLM_API_KEY=
# The Scout's model, and a different one for the Verifier.
LLM_MODEL_FAST=
LLM_MODEL_STRONG=

# neatlogs project key, from the neatlogs dashboard.
NEATLOGS_API_KEY=

# Dashboard limits, because the site is public and every Run costs money. Optional.
# DASHBOARD_MAX_ACTIVE_JOBS=20
# DASHBOARD_MAX_RUN_NOW_PER_DAY=3
